#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(dirname "$(realpath "$0")")"
ROOT="$(dirname "$SCRIPT_DIR")"

ENV_EXAMPLE="$ROOT/.env.example"
ENV_FILE="$ROOT/.env"
CONDA_ENV_NAME="aihelms"

# 1) 复制环境变量
if [ ! -f "$ENV_FILE" ]; then
  cp "$ENV_EXAMPLE" "$ENV_FILE"
  echo "已创建 .env（请检查端口和密码配置）"
fi

# 2) 创建 conda 环境并安装 Python 依赖
if command -v conda &> /dev/null; then
  if ! conda env list | grep -q "^${CONDA_ENV_NAME} "; then
    echo "创建 conda 环境: ${CONDA_ENV_NAME} (Python 3.11)..."
    conda create -n "$CONDA_ENV_NAME" python=3.11 -y
  fi
  echo "激活 conda 环境: ${CONDA_ENV_NAME}"
  eval "$(conda shell.bash hook)"
  conda activate "$CONDA_ENV_NAME"
else
  echo "警告: 未检测到 conda，使用当前 Python 环境"
fi

echo "安装 Python 依赖..."
cd "$ROOT/apps"
pip install -i https://mirrors.aliyun.com/pypi/simple/ -e ".[dev]"

# 3) 安装前端依赖（使用淘宝镜像加速）
echo "安装前端依赖..."
cd "$ROOT/ui"
npm config set registry https://registry.npmmirror.com
npm install

echo ""
echo "setup 完成！"
echo ""
echo "下一步："
echo "  1. 检查 .env 配置（端口、密码）"
echo "  2. 激活环境:   conda activate ${CONDA_ENV_NAME}"
echo "  3. 启动中间件: ./dev/start-docker-compose"
echo "  4. 启动后端:   ./dev/start-api"
echo "  5. 启动前端:   ./dev/start-web"
