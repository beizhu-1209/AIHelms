upstream aihelms_api {
    server aihelms:8000;
}

upstream dsh_manager {
    server dsh:8080;
}

server {
    listen 80;
    server_name ${NGINX_SERVER_NAME};

    # 安全头（暂不加 X-Frame-Options，web 端后续需被其他系统 iframe 嵌入，改用 CSP frame-ancestors）
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # AIHelms API 代理
    location ^~ /api/v1/ {
        proxy_pass http://aihelms_api;
        include /etc/nginx/proxy.conf;
    }

    # DSH events are downlink WebSocket channels; keep ordinary /api/ SSE as HTTP.
    location = /api/events.mux {
        proxy_pass http://dsh_manager;
        include /etc/nginx/proxy.conf;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    location = /api/events.host {
        proxy_pass http://dsh_manager;
        include /etc/nginx/proxy.conf;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # DSH API、SSE 和 WebSocket
    location ^~ /api/ {
        proxy_pass http://dsh_manager;
        include /etc/nginx/proxy.conf;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header Cookie $http_cookie;
    }

    # DSH Web 的根路径静态资源
    location ^~ /plugins/ {
        proxy_pass http://dsh_manager;
        include /etc/nginx/proxy.conf;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header Cookie $http_cookie;
    }

    location ^~ /assets/ {
        proxy_pass http://dsh_manager;
        include /etc/nginx/proxy.conf;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header Cookie $http_cookie;
    }

    location ^~ /sidebar/ {
        proxy_pass http://dsh_manager;
        include /etc/nginx/proxy.conf;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    location = /dsh {
        return 301 /dsh/;
    }

    location ^~ /dsh/ {
        proxy_pass http://dsh_manager/;
        include /etc/nginx/proxy.conf;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # 管理后台
    location = /admin {
        rewrite ^ /admin/ last;
    }
    location /admin/ {
        alias /usr/share/nginx/html/admin/;
        try_files $uri $uri/ /admin/index.html;
    }

    # 平台内置图标
    location /icons/ {
        root /usr/share/nginx/html/web;
        try_files $uri /icons/v1/default.svg;
        add_header Cache-Control "public, max-age=86400";
    }

    # 用户端（默认）
    location / {
        root /usr/share/nginx/html/web;
        try_files $uri $uri/ /index.html;
    }
}
