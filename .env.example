# ============================================================
# AIHelms 环境变量配置
# 复制此文件为 .env 并填入实际值
# ============================================================

# ------------------------------------------------------------
# PostgreSQL 数据库
# 被 db、litellm、aihelms 三个服务共用
# DB_PORT: 宿主机映射端口（开发中间件用）
# ------------------------------------------------------------
POSTGRES_USER=aihelms
POSTGRES_PASSWORD=aihelms
POSTGRES_DB=aihelms
DB_PORT=5432

# ------------------------------------------------------------
# Redis
# 用于 session 管理、API 限流、缓存
# REDIS_PORT: 宿主机映射端口（开发中间件用）
# ------------------------------------------------------------
REDIS_PASSWORD=aihelms
REDIS_PORT=6379

# ------------------------------------------------------------
# LiteLLM 配置
# master_key: 管理 LiteLLM 的主密钥，用于创建/管理虚拟 key，必须以sk-开头
# salt_key: 用于加密存储在数据库中的模型 API Key
#           首次设置后不可更改，否则已存储的 key 将无法解密
# LITELLM_PORT: 对外暴露端口（外部 AI 客户端直接访问）
# ------------------------------------------------------------
LITELLM_MASTER_KEY=sk-your-litellm-master-key
LITELLM_SALT_KEY=your-salt-key-do-not-change-after-set
LITELLM_PORT=4000

# ------------------------------------------------------------
# AIHelms 后端
# AIHELMS_VERSION: 镜像版本号
# SECRET_KEY: JWT 签名密钥，用于用户认证 token
# SUPER_ADMIN_PASSWORD: 超级管理员初始密码（首次启动时创建）
# 注：DATABASE_URL、REDIS_URL、LITELLM_URL 由上面的变量自动拼接，无需手动配置
# ------------------------------------------------------------
AIHELMS_VERSION=0.1.20
SECRET_KEY=your_jwt_secret_key_here
SUPER_ADMIN_PASSWORD=admin123

# ------------------------------------------------------------
# DS Harness Beta
# DSH_ENABLED=false 时，AIHelms 页面不显示 DSH 菜单，DSH manager 也不提供代理。
# DSH_ENABLED=true 时，已登录用户访问 DSH 菜单后，manager 按用户创建独立 runtime 容器。
# 镜像仓库地址由 docker-compose.yml 固定；下面两个变量只填写镜像 tag。
# ------------------------------------------------------------
# 是否启用 AIHelms 的 DSH 菜单、会话接口和 DSH manager 代理。
DSH_ENABLED=true
# DSH runtime 镜像版本，必须与 DSH 定制项目构建并推送的 runtime tag 完全一致。
DSH_VERSION=dsh-v0.1.1-rc.2
# AIHelms 侧 dsh-manager 镜像版本，只有 manager 代码/依赖变化时才需要更新。
DSH_MANAGER_VERSION=0.1.1
# 用户 DSH 容器加入的 Docker 网络名称；必须是 nginx/manager 可访问的同一网络。
DSH_USER_NETWORK=aihelms-dsh-user
# 用户容器无请求后的空闲回收阈值，单位为秒。默认 1800 秒（30 分钟）。
# manager 每 30 秒检查一次；实际回收时间可能比阈值晚最多约 30 秒。
DSH_CONTAINER_IDLE_TIMEOUT_SECONDS=1800
# 回收时先发送 stop，等待容器退出的宽限时间，单位为秒。超时后强制删除容器。
DSH_CONTAINER_RECLAIM_GRACE_SECONDS=60
# 新容器启动后等待 DSH Web 返回成功响应的最长时间，单位为秒；超时则本次访问返回失败。
DSH_CONTAINER_START_TIMEOUT_SECONDS=30
# 同时运行的用户 DSH 容器数量上限；达到上限后，新用户不会创建容器。
DSH_CONTAINER_MAX_COUNT=20

# ------------------------------------------------------------
# AI Policies / SkillSpector
# SKILLSPECTOR_VERSION: SkillSpector image version
# AI_POLICIES_TIMEOUT_SECONDS: Skill audit timeout in seconds
# ------------------------------------------------------------
SKILLSPECTOR_VERSION=0.1.0
AI_POLICIES_TIMEOUT_SECONDS=600

# 成本计算
# USD_TO_CNY_RATE: LiteLLM spend(美元) → 人民币汇率
USD_TO_CNY_RATE=7

# ------------------------------------------------------------
# Gunicorn（生产模式）
# GUNICORN_WORKERS: worker 数量，0=自动（CPU*2+1）
# GUNICORN_TIMEOUT: 请求超时秒数
# GUNICORN_KEEPALIVE: keep-alive 秒数
# GUNICORN_MAX_REQUESTS: worker 处理多少请求后重启（防内存泄漏）
# GUNICORN_MAX_REQUESTS_JITTER: max_requests 随机偏移
# GUNICORN_LOGLEVEL: 日志级别 (debug/info/warning/error)
# ------------------------------------------------------------
GUNICORN_WORKERS=5
GUNICORN_TIMEOUT=120
GUNICORN_KEEPALIVE=5
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=50
GUNICORN_LOGLEVEL=info

# ------------------------------------------------------------
# Celery Worker
# CELERY_WORKER_CONCURRENCY: 并发数，0=自动（CPU核数）
# CELERY_LOGLEVEL: 日志级别
# CELERY_PREFETCH_MULTIPLIER: 预取任务数
# ------------------------------------------------------------
CELERY_WORKER_CONCURRENCY=5
CELERY_LOGLEVEL=info
CELERY_PREFETCH_MULTIPLIER=1

# ------------------------------------------------------------
# 日志
# LOG_DIR: 日志存储目录，按天轮转，保留30天
#   开发模式: ../logs（相对于 apps/ 目录，即项目根目录下的 logs/）
#   Docker模式: docker-compose.yml 中覆盖为 /logs（容器内路径，映射到 ./logs）
# LOG_LEVEL: 日志级别 (DEBUG/INFO/WARNING/ERROR)
#   开发模式建议 INFO 或 DEBUG，生产默认 WARNING
# ------------------------------------------------------------
LOG_DIR=../logs
LOG_LEVEL=WARNING

# ------------------------------------------------------------
# 文件存储
# DATA_DIR: 数据存储根目录（用户上传的 Skill zip 包、附件、导出文件等）
#   开发模式: ../data（相对于 apps/ 目录，即项目根目录下的 data/）
#   Docker模式: docker-compose.yml 中覆盖为 /data（容器内路径，映射到 ./data）
# 子目录会自动创建：
#   skills/   — Skill zip 包
#   uploads/  — 通用上传文件（图标等）
#   exports/  — 导出文件（日志/报表等）
# ------------------------------------------------------------
DATA_DIR=../data

# ------------------------------------------------------------
# 安全 - 管理员审计日志
# AUDIT_LOG_RETENTION_DAYS: 审计日志保留天数，超过会被定时任务清理
# ------------------------------------------------------------
AUDIT_LOG_RETENTION_DAYS=180

# ------------------------------------------------------------
# 数据中心 - LLM 调用日志
# LLM_LOG_SYNC_INTERVAL_MINUTES: 从 LiteLLM 增量同步 LLM 日志的间隔（分钟）
# LLM_LOG_RETENTION_DAYS: LLM 日志保留天数，0=不清理
# ------------------------------------------------------------
LLM_LOG_SYNC_INTERVAL_MINUTES=5
LLM_LOG_RETENTION_DAYS=0

# ------------------------------------------------------------
# Nginx 网关
# WEB_PORT: 对外端口（映射到容器内 80）
# NGINX_SERVER_NAME: 访问域名或 IP（用于 Nginx server_name）
#                    多个域名用空格分隔，如 "aihelms.example.com 192.168.1.100"
# NGINX_CLIENT_MAX_BODY_SIZE: 请求体大小限制
# NGINX_PROXY_READ_TIMEOUT: 代理读取超时
# NGINX_PROXY_SEND_TIMEOUT: 代理发送超时
# ------------------------------------------------------------
WEB_PORT=80
NGINX_SERVER_NAME=0.0.0.0
NGINX_WORKER_PROCESSES=auto
NGINX_CLIENT_MAX_BODY_SIZE=100M
NGINX_PROXY_READ_TIMEOUT=300s
NGINX_PROXY_SEND_TIMEOUT=300s

# ------------------------------------------------------------
# Docker 容器日志
# DOCKER_LOG_MAX_SIZE: 单个日志文件大小上限
# DOCKER_LOG_MAX_FILE: 保留的日志文件数量
# ------------------------------------------------------------
DOCKER_LOG_MAX_SIZE=50m
DOCKER_LOG_MAX_FILE=5

# ------------------------------------------------------------
# 时区
# 所有容器统一使用此时区
# ------------------------------------------------------------
TZ=Asia/Shanghai
